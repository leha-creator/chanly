# Продакшен: переменные бэкенда (api, worker, migrate, backup). Полный список и значения по
# умолчанию — .env.example в корне; здесь только обязательное в production и отличия.
# На сервере файл лежит как /opt/maxim-production/app.env (владелец deploy, права 600) и
# заполняется из хранилища секретов человеком. Значения с меткой ПРЕДПОЛОЖЕНИЕ придуманы.
# CHANGE_ME — секрет; CHANGE_ME_BASE64_32B — `openssl rand -base64 32`.
# Проверка перед выпуском: release.sh вызывает `maxim config check --for api|worker|migrate`.

APP_ENV=production
LOG_LEVEL=info

HTTP_ADDR=:8080
METRICS_ADDR=:9090
# Production API: chanly.ru.
PUBLIC_BASE_URL=https://chanly.ru
# Сеть edge-прокси; уточнить `docker network inspect edge`.
TRUSTED_PROXY_CIDRS=172.16.0.0/12
COOKIE_SECURE=true
HTTP_SHUTDOWN_DRAIN=5s

DATABASE_URL=postgres://maxim_app:CHANGE_ME@postgres:5432/maxim?sslmode=disable
DB_APP_ROLE=maxim_app
DB_MAX_CONNS=20

# ПРЕДПОЛОЖЕНИЕ: S3 провайдера в России (Selectel, ru-1); публичная корзина за своим доменом.
S3_ENDPOINT=s3.chanly.ru
S3_REGION=us-east-1
S3_BUCKET_PRIVATE=maxim-production-private
S3_BUCKET_PUBLIC=maxim-production-public
S3_PUBLIC_BASE_URL=https://s3.chanly.ru/maxim-production-public
S3_PRESIGN_ENDPOINT=
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_USE_SSL=true

# ПРЕДПОЛОЖЕНИЕ: SMTP российского сервиса рассылок, TLS.
SMTP_HOST=smtp.unisender.ru
SMTP_PORT=465
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_TLS=tls
MAIL_FROM=noreply@maxim-ads.ru

APP_SECRETS_KEY=CHANGE_ME_BASE64_32B
AUTH_CODE_PEPPER=CHANGE_ME

MAX_API_URL=https://platform-api2.max.ru
MAX_BOT_TOKEN=CHANGE_ME
MAX_CA_CERT_FILE=/etc/maxim/certs/russian_trusted_root_ca.pem
MAX_BOT_NAME=@maxim_ads_bot
MAX_WEBHOOK_PATH_SECRET=CHANGE_ME
MAX_WEBHOOK_SECRET=CHANGE_ME
MAX_WEBHOOK_URL=https://chanly.ru/api/v1/webhooks/max

ORD_ENABLED=true
ORD_API_URL=https://ord.yandex.net
ORD_OAUTH_TOKEN=CHANGE_ME
# Код ККТУ всех креативов (A-42, Q-39): подтвердить с юристом.
ORD_KKTU_CODE=30.15.1
# ПРЕДПОЛОЖЕНИЕ: реквизиты ИП платформы (заглушка с корректной контрольной суммой ИНН).
ORD_PLATFORM_INN=500100732259
ORD_PLATFORM_NAME=ИП Иванов Иван Иванович
ORD_PLATFORM_LEGAL_TYPE=sole_proprietor
ORD_CONTRACT_NUMBER_PREFIX=MX-

# ПРЕДПОЛОЖЕНИЕ: реквизиты платформы в счетах и закрывающих документах — заменить настоящими.
PLATFORM_OGRNIP=304500116000157
PLATFORM_ADDRESS=CHANGE_ME
PLATFORM_BANK_ACCOUNT=CHANGE_ME
PLATFORM_BANK_NAME=CHANGE_ME
PLATFORM_BANK_BIK=CHANGE_ME
PLATFORM_BANK_CORR_ACCOUNT=CHANGE_ME
INVOICE_VAT_NOTE=Без НДС

# Комиссия платформы (A-30): должна совпадать с правилами площадки (docs/launch/legal-documents.md).
PLATFORM_FEE_RATE_BP=1500

# Оповещения дежурным: хотя бы один адресат обязателен.
ALERT_EMAILS=CHANGE_ME
ALERT_MAX_CHAT_ID=

# =============================================================================
# === Модули в разработке ===
# Переменные модулей добавляются в свой подраздел после слияния их веток; см. .env.example.
#
# --- Выплаты блогерам (Рокет Ворк): ROCKETWORK_*, PAYOUT_* ---
# Реализовано по OpenAPI; живая приёмка ещё не выполнена. Sandbox URL не подтверждён.
# Live-чтение не включает workflow. Production automation требует отдельного допуска.
# Секреты — из приватного окружения. Инструкции: docs/05-integrations.md §4.
ROCKETWORK_MODE=disabled
ROCKETWORK_BASE_URL=
# Explicit contract policy; empty values do not authorize a contract/payment.
ROCKETWORK_WORKFLOW_ENABLED=false
# Separate owner admission after live acceptance; never enabled by tests.
ROCKETWORK_PRODUCTION_APPROVED=false
ROCKETWORK_TARGET=
ROCKETWORK_ACCOUNT_KEY=
ROCKETWORK_CONTRACT_MODE=
ROCKETWORK_TASK_TITLE=
ROCKETWORK_TASK_DESCRIPTION=
ROCKETWORK_DOCUMENT_NAME=
ROCKETWORK_DOCUMENT_NUMBER=
ROCKETWORK_DOCUMENT_DATE=
ROCKETWORK_PERIOD_FROM=
ROCKETWORK_PERIOD_TO=
ROCKETWORK_ACT_REQUIRED=
ROCKETWORK_TAX_RETENTION=
# Own-funds Withdrawal destination, approved separately.
ROCKETWORK_WITHDRAWAL_COMPANY_INN=
ROCKETWORK_WITHDRAWAL_BIC=
ROCKETWORK_WITHDRAWAL_ACCOUNT=
ROCKETWORK_WITHDRAWAL_EXECUTOR_ID=
ROCKETWORK_MAX_COMMISSION_KOPECKS=
# Секреты: API-токен и отдельный Bearer-токен подписки (в fake — HMAC-ключ, не короче 16 символов;
# обязателен при live, с fake пусто — ключ разработки).
ROCKETWORK_TOKEN=
ROCKETWORK_PREVIOUS_WEBHOOK_SECRET=
ROCKETWORK_WEBHOOK_SECRET=

#
# --- Уведомления и отчёт по кампании ---
# Адрес кабинета для ссылок в уведомлениях (ПРЕДПОЛОЖЕНИЕ П-2: домен кабинета).
CABINET_BASE_URL=https://app.maxim-ads.ru
#
# --- Приёмка, споры и возвраты ---
# Снижение рейтинга канала (0…100) по решению спора: full_refund и proportional (A-08, 03 §6);
# 0 — без санкции. ПРЕДПОЛОЖЕНИЕ (Q-18): денежных штрафов нет, санкция — только рейтинг.
DISPUTE_RATING_PENALTY_REFUND=10
DISPUTE_RATING_PENALTY_PROPORTIONAL=5
#
# --- API администратора и отчётность ОРД ---
# Срок запроса второго подтверждения денежной операции (R-2), 1h…720h. ПРЕДПОЛОЖЕНИЕ (Q-45).
ADMIN_APPROVAL_TTL=72h
# Ежемесячная отчётность ОРД (05 §3.7). Тип акта по изначальному договору и по договору с
# блогером; номер акта — <префикс>-ГГГГММ-N. ПРЕДПОЛОЖЕНИЕ (Q-43): значения типов уточнить в ОРД.
ORD_INVOICE_TYPE_INITIAL=intermediary-report
ORD_INVOICE_TYPE_PUBLISHER=invoice
ORD_INVOICE_NUMBER_PREFIX=MX
# true — задание 1-го числа сразу отправляет отчёт; false — отправляет senior после просмотра.
ORD_REPORT_AUTO_SEND=false
# С этого числа месяца неотправленный отчёт прошлого месяца — оповещение (1…28).
ORD_REPORT_ERROR_DAY=20
#
# =============================================================================

# Т-Банк: опрос выписки выключен до явной настройки и согласования начальной даты.
TBANK_MODE=disabled
# Доступ: readonly по умолчанию; controlled — ограниченный dev; automation — отдельно допущенный production/sandbox.
TBANK_ACCESS_MODE=readonly
TBANK_DEV_REAL_ENABLED=false
TBANK_PRODUCTION_APPROVED=false
TBANK_CONTROLLED_RUN_ID=
TBANK_CONTROLLED_ORGANIZATION_ID=
TBANK_CONTROLLED_MAX_PAYMENT_KOPECKS=10000
TBANK_CONTROLLED_MAX_TOTAL_KOPECKS=50000
TBANK_CONTROLLED_EXPIRES_AT=
TBANK_API_URL=https://business.tbank.ru/openapi
TBANK_TOKEN=
TBANK_CA_CERT_FILE=/etc/maxim/certs/russian_trusted_root_ca.crt
TBANK_IMPORT_FROM=
TBANK_POLL_INTERVAL=5m
TBANK_PERIOD=24h
TBANK_OVERLAP=168h
TBANK_STALE_AFTER=30m
TBANK_RATE=5
