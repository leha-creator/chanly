# Тестовое окружение: переменные бэкенда (api, worker, migrate, backup). Полный список и значения
# по умолчанию — .env.example в корне; здесь только то, что отличается или обязательно.
# На сервере файл лежит как /opt/maxim-staging/app.env (владелец deploy, права 600).
# Значения с меткой ПРЕДПОЛОЖЕНИЕ придуманы и подлежат замене. CHANGE_ME — секрет из хранилища
# секретов; CHANGE_ME_BASE64_32B — `openssl rand -base64 32`. Данные продакшена сюда не переносятся.
#
# Внешние системы: пусто — работает подделка в процессе, заполнено — тестовый контур.
#   MAX        — MAX_BOT_TOKEN тестового бота; пусто — поддельный адаптер (события шлются вручную).
#   Яндекс ОРД — ORD_OAUTH_TOKEN кабинета ord-prestable + ORD_KKTU_CODE; пусто — ordfake.
#   Банк       — подделки нет и не нужно: файл выписки «1С» делает `maxim dev statement`,
#                загружает `maxim admin money statement import` (README, «Деньги в разработке»).
#   Почта      — Mailpit из профиля mailpit (ниже); для настоящих писем — SMTP провайдера.
#   Рокет Ворк — disabled (подделке нужен общий для api и worker файл); тестовая среда — live
#                (Q-12), блок «Модули в разработке» в конце.

# APP_ENV=development: подделка включается отсутствием токена, команды `maxim dev` доступны.
# APP_ENV=test не подходит — в нём всегда подделки и хранилище в памяти (только для тестов Go).
APP_ENV=development
LOG_LEVEL=debug

HTTP_ADDR=:8080
METRICS_ADDR=:9090
# ПРЕДПОЛОЖЕНИЕ: адрес тестового окружения.
PUBLIC_BASE_URL=https://stage-api.maxim-ads.ru
# Сеть edge-прокси (Docker выделяет подсети из 172.16.0.0/12); уточнить `docker network inspect edge`.
TRUSTED_PROXY_CIDRS=172.16.0.0/12
COOKIE_SECURE=true
HTTP_SHUTDOWN_DRAIN=5s

# Роль приложения; пароль совпадает с POSTGRES_APP_PASSWORD в stack.env.
DATABASE_URL=postgres://maxim_app:CHANGE_ME@postgres:5432/maxim?sslmode=disable
DB_APP_ROLE=maxim_app
DB_MAX_CONNS=10

# ПРЕДПОЛОЖЕНИЕ: S3 провайдера в России (Selectel, регион ru-1), корзины окружения.
S3_ENDPOINT=s3.ru-1.storage.selcloud.ru
S3_REGION=ru-1
S3_BUCKET_PRIVATE=maxim-staging-private
S3_BUCKET_PUBLIC=maxim-staging-public
S3_PUBLIC_BASE_URL=https://maxim-staging-public.s3.ru-1.storage.selcloud.ru
S3_PRESIGN_ENDPOINT=
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_USE_SSL=true

# Почта: Mailpit (docker compose --profile mailpit). Веб-интерфейс — 127.0.0.1:8025 на сервере,
# смотреть через `ssh -L 8025:127.0.0.1:8025 deploy@<host>`.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=none
MAIL_FROM=noreply@stage-api.maxim-ads.ru

APP_SECRETS_KEY=CHANGE_ME_BASE64_32B
AUTH_CODE_PEPPER=CHANGE_ME

# MAX: пусто — подделка. Тестовый бот — токен, сертификат Минцифры, адрес Webhook.
MAX_BOT_TOKEN=
# Только maxim integration-check; заполнить ID отдельного тестового канала.
INTEGRATION_CHECK_MAX_CHAT_ID=
# Сертификат проверяется при запуске (файл должен быть в образе, deploy/certs/README.md):
# задать вместе с MAX_BOT_TOKEN, когда сертификат добавлен в репозиторий.
# MAX_CA_CERT_FILE=/etc/maxim/certs/russian_trusted_root_ca.pem
MAX_CA_CERT_FILE=
MAX_BOT_NAME=@maxim_stage_bot
MAX_WEBHOOK_PATH_SECRET=CHANGE_ME
MAX_WEBHOOK_SECRET=CHANGE_ME
MAX_WEBHOOK_URL=https://stage-api.maxim-ads.ru/api/v1/webhooks/max

# Яндекс ОРД: пусто — ordfake; токен кабинета ord-prestable — тестовый контур (ORD_API_URL
# по умолчанию https://ord-prestable.yandex.net).
ORD_ENABLED=true
ORD_API_URL=https://ord-prestable.yandex.net
ORD_API_VERSION=v8
ORD_OAUTH_TOKEN=
ORD_KKTU_CODE=
ORD_PLATFORM_INN=
ORD_PLATFORM_NAME=
ORD_CONTRACT_NUMBER_PREFIX=STAGE-

# Реквизиты платформы: пусто — значения разработки (вне production подставляются сами).
PLATFORM_OGRNIP=
PLATFORM_ADDRESS=

# Оповещения дежурным — в Mailpit.
ALERT_EMAILS=oncall@stage-api.maxim-ads.ru
ALERT_MAX_CHAT_ID=

# =============================================================================
# === Модули в разработке ===
# Переменные модулей добавляются в свой подраздел после слияния их веток; см. .env.example.
#
# --- Выплаты блогерам (Рокет Ворк): ROCKETWORK_*, PAYOUT_* ---
# Реализовано по OpenAPI; живая приёмка ещё не выполнена. Sandbox URL не подтверждён.
# Live-чтение не включает workflow. Production automation требует отдельного допуска.
# Секреты — из приватного окружения. Инструкции: docs/05-integrations.md §4.
ROCKETWORK_MODE=disabled
ROCKETWORK_ACCESS_MODE=readonly
ROCKETWORK_PURPOSE=
ROCKETWORK_BASE_URL=
# Explicit contract policy; empty values do not authorize a contract/payment.
ROCKETWORK_WORKFLOW_ENABLED=false
# Separate owner admission after live acceptance; never enabled by tests.
ROCKETWORK_PRODUCTION_APPROVED=false
ROCKETWORK_TARGET=
ROCKETWORK_ACCOUNT_KEY=
ROCKETWORK_CONTRACT_MODE=
ROCKETWORK_TASK_TITLE=
ROCKETWORK_TASK_DESCRIPTION=
ROCKETWORK_DOCUMENT_NAME=
ROCKETWORK_DOCUMENT_NUMBER=
ROCKETWORK_DOCUMENT_DATE=
ROCKETWORK_PERIOD_FROM=
ROCKETWORK_PERIOD_TO=
ROCKETWORK_ACT_REQUIRED=
ROCKETWORK_TAX_RETENTION=
# Own-funds Withdrawal destination, approved separately.
ROCKETWORK_WITHDRAWAL_COMPANY_INN=
ROCKETWORK_WITHDRAWAL_BIC=
ROCKETWORK_WITHDRAWAL_ACCOUNT=
ROCKETWORK_WITHDRAWAL_EXECUTOR_ID=
ROCKETWORK_MAX_COMMISSION_KOPECKS=
# Секреты: API-токен и отдельный Bearer-токен подписки (в fake — HMAC-ключ, не короче 16 символов;
# обязателен при live, с fake пусто — ключ разработки).
ROCKETWORK_TOKEN=
ROCKETWORK_PREVIOUS_WEBHOOK_SECRET=
ROCKETWORK_WEBHOOK_SECRET=

#
# --- Уведомления и отчёт по кампании ---
# Адрес кабинета для ссылок в уведомлениях (ПРЕДПОЛОЖЕНИЕ П-2: домен кабинета).
CABINET_BASE_URL=https://stage.maxim-ads.ru
#
# --- Приёмка, споры и возвраты ---
# Снижение рейтинга канала (0…100) по решению спора: full_refund и proportional (A-08, 03 §6);
# 0 — без санкции. ПРЕДПОЛОЖЕНИЕ (Q-18): денежных штрафов нет, санкция — только рейтинг.
DISPUTE_RATING_PENALTY_REFUND=10
DISPUTE_RATING_PENALTY_PROPORTIONAL=5
#
# --- API администратора и отчётность ОРД ---
# Срок запроса второго подтверждения денежной операции (R-2), 1h…720h. ПРЕДПОЛОЖЕНИЕ (Q-45).
ADMIN_APPROVAL_TTL=72h
# Ежемесячная отчётность ОРД (05 §3.7). Тип акта по изначальному договору и по договору с
# блогером; номер акта — <префикс>-ГГГГММ-N. ПРЕДПОЛОЖЕНИЕ (Q-43): значения типов уточнить в ОРД.
ORD_INVOICE_TYPE_INITIAL=intermediary-report
ORD_INVOICE_TYPE_PUBLISHER=invoice
ORD_INVOICE_NUMBER_PREFIX=MX
# true — задание 1-го числа сразу отправляет отчёт; false — отправляет senior после просмотра.
ORD_REPORT_AUTO_SEND=false
# С этого числа месяца неотправленный отчёт прошлого месяца — оповещение (1…28).
ORD_REPORT_ERROR_DAY=20
#
# =============================================================================

# Т-Банк: опрос выписки выключен до явной настройки и согласования начальной даты.
TBANK_MODE=disabled
# Доступ: readonly по умолчанию; controlled — dev с флагом и кодом назначения; automation — отдельно допущенный production/sandbox.
TBANK_ACCESS_MODE=readonly
TBANK_DEV_REAL_ENABLED=false
TBANK_PRODUCTION_APPROVED=false
TBANK_DEV_PAYMENT_CODE=
TBANK_API_URL=https://business.tbank.ru/openapi/sandbox
TBANK_TOKEN=
TBANK_CA_CERT_FILE=/etc/maxim/certs/russian_trusted_root_ca.crt
TBANK_IMPORT_FROM=
TBANK_POLL_INTERVAL=5m
TBANK_PERIOD=24h
TBANK_OVERLAP=168h
TBANK_STALE_AFTER=30m
TBANK_RATE=5
