# Dev SPA from maxim-frontend; API stays on the real backend.
__DOMAIN__ {
    # MAX cannot send browser Basic Auth. The application validates both the
    # secret path and X-Max-Bot-Api-Secret before recording an event.
    @max_webhook {
        method POST
        path_regexp max_webhook ^/api/v1/webhooks/max/[A-Za-z0-9_-]+$
    }
    # The callback URL and header are secrets; do not put them in access logs.
    @max_webhook_log path /api/v1/webhooks/max/*
    log_skip @max_webhook_log
    # RocketWork authenticates callbacks with its own application Bearer secret.
    @rocketwork_webhook {
        method POST
        path /api/v1/webhooks/rocketwork
    }
    @rocketwork_webhook_log path /api/v1/webhooks/rocketwork
    log_skip @rocketwork_webhook_log
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
    log {
        output stdout
        format json
    }
    request_body {
        max_size 52MB
    }
    route {
        reverse_proxy @rocketwork_webhook __PREFIX__-api-a:8080 __PREFIX__-api-b:8080 {
            lb_policy first
            lb_try_duration 10s
            lb_try_interval 250ms
            fail_duration 10s
            health_uri /readyz
            health_interval 2s
            health_timeout 1s
        }
        reverse_proxy @max_webhook __PREFIX__-api-a:8080 __PREFIX__-api-b:8080 {
            header_up -Authorization
            lb_policy first
            lb_try_duration 10s
            lb_try_interval 250ms
            fail_duration 10s
            health_uri /readyz
            health_interval 2s
            health_timeout 1s
            health_status 200
        }
        import /etc/caddy/auth/dev.caddy
        @admin_denied {
            path /api/v1/admin /api/v1/admin/*
            not remote_ip __ADMIN_ALLOW__
        }
        handle @admin_denied {
            header Content-Type "application/json"
            respond `{"error":{"code":"forbidden","message":"admin api is not available from this address"}}` 403
        }
        handle /api/landing/contact {
            request_body {
                max_size 32KB
            }
            reverse_proxy chanly-landing-contact:8091 {
                header_up -Authorization
                header_up X-Real-IP {remote_host}
                transport http {
                    dial_timeout 3s
                    response_header_timeout 30s
                }
            }
        }
        @backend path /api /api/* /docs /docs/* /openapi.json /readyz /healthz /livez
        handle @backend {
            reverse_proxy __PREFIX__-api-a:8080 __PREFIX__-api-b:8080 {
                header_up -Authorization
                # A session 401 must not invalidate the browser's outer Basic Auth cache.
                # The frontend restores the API status from this explicit marker.
                @session_missing status 401
                handle_response @session_missing {
                    header X-Chanly-Auth-Status "401"
                    copy_response 403
                }
                lb_policy first
                lb_try_duration 10s
                lb_try_interval 250ms
                fail_duration 10s
                health_uri /readyz
                health_interval 2s
                health_timeout 1s
                health_status 200
            }
        }
        @shared_root {
            method GET HEAD
            path /
            file {
                root /srv/maxim-dev/landing/current
                try_files /index.html
            }
        }
        handle @shared_root {
            header Cache-Control "private, no-store"
            reverse_proxy __PREFIX__-api-a:8080 __PREFIX__-api-b:8080 {
                method GET
                rewrite /api/v1/me?
                header_up -Authorization
                header_up -If-None-Match
                header_up -If-Modified-Since
                lb_policy first
                lb_try_duration 5s
                fail_duration 10s
                @member status 200
                handle_response @member {
                    root * /srv/maxim-dev/current
                    rewrite * /index.html
                    file_server
                }
                @guest status 401
                handle_response @guest {
                    root * /srv/maxim-dev/landing/current
                    rewrite * /index.html
                    file_server
                }
                handle_response {
                    header Retry-After 5
                    respond "Session check failed. Please refresh." 503
                }
            }
        }
        handle /landing-assets/* {
            root * /srv/maxim-dev/landing/shared
            header Cache-Control "public, max-age=31536000, immutable"
            file_server
        }
        handle /assets/* {
            root * /srv/maxim-dev/current
            header Cache-Control "public, max-age=31536000, immutable"
            file_server
        }
        handle {
            root * /srv/maxim-dev/current
            header Cache-Control "no-cache"
            try_files {path} /index.html
            file_server
        }
    }
    handle_errors 502 503 504 {
        header Content-Type "application/json"
        respond `{"error":{"code":"unavailable","message":"service is temporarily unavailable"}}` 503
    }
}

mail.__DOMAIN__ {
    import /etc/caddy/auth/dev.caddy
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        -Server
    }
    reverse_proxy __PREFIX__-mailpit:8025 {
        header_up -Authorization
    }
}
