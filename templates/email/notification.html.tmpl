<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="format-detection" content="telephone=no,date=no,address=no,email=no">
  <title>{{.Title}}</title>
  <style>
    table { border-collapse: collapse; mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
    @media screen and (max-width: 600px) {
      .outer { padding: 16px 8px !important; }
      .content { padding: 28px 20px !important; }
      .header { padding: 20px !important; }
      h1 { font-size: 24px !important; line-height: 32px !important; }
    }
  </style>
</head>
<body style="margin: 0; padding: 0; width: 100%; background-color: #f6f7fb; color: #182230; font-family: Arial, Helvetica, sans-serif; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" bgcolor="#f6f7fb">
    <tr><td class="outer" align="center" style="padding: 32px 16px;">
      <!--[if mso]><table role="presentation" width="600" align="center"><tr><td><![endif]-->
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width: 100%; max-width: 600px;">
        <tr><td class="header" bgcolor="#171b30" style="padding: 24px 32px; background-color: #171b30; border-radius: 16px 16px 0 0;">
          <img src="https://raw.githubusercontent.com/leha-creator/chanly/master/docs/assets/chanly-logo-email.png" width="144" height="44" alt="Chanly" style="display: block; width: 144px; height: 44px; border: 0; color: #ffffff; font-size: 24px; font-weight: bold;">
        </td></tr>
        <tr><td class="content" bgcolor="#ffffff" style="padding: 36px 32px; background-color: #ffffff; border-radius: 0 0 16px 16px; overflow-wrap: anywhere; word-wrap: break-word;">
          <h1 style="margin: 0 0 24px; font-size: 28px; line-height: 36px;">{{.Title}}</h1>
          {{range .Paragraphs}}<p style="margin: 0 0 20px; font-size: 16px; line-height: 26px; white-space: pre-line;">{{.}}</p>
          {{end}}{{if .Link}}<table role="presentation" cellpadding="0" cellspacing="0"><tr><td align="center" bgcolor="#514fde" style="background-color: #514fde; border-radius: 8px; mso-padding-alt: 14px 24px;">
            <a href="{{.Link}}" style="display: inline-block; padding: 14px 24px; border: 1px solid #514fde; border-radius: 8px; color: #ffffff; font-size: 16px; line-height: 24px; font-weight: 700; text-align: center; text-decoration: none; mso-padding-alt: 0;">Открыть в кабинете</a>
          </td></tr></table>
          <p style="margin: 24px 0 0; color: #5d687a; font-size: 13px; line-height: 21px;">Если кнопка не открывается, перейдите по ссылке:<br><a href="{{.Link}}" style="color: #423fc0; text-decoration: underline; overflow-wrap: anywhere; word-break: break-all;">{{.Link}}</a></p>{{end}}
        </td></tr>
        <tr><td align="center" style="padding: 24px 20px; color: #5d687a; font-size: 13px; line-height: 20px;">Chanly<br>Письмо отправлено автоматически, отвечать на него не нужно.</td></tr>
      </table>
      <!--[if mso]></td></tr></table><![endif]-->
    </td></tr>
  </table>
</body>
</html>
